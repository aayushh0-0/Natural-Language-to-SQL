# ==============================================================================
# Natural Language -> SQL Configuration Environment Variables
# ==============================================================================

# LLM Provider: "mock", "anthropic", or "openai"
# Default is "mock" for offline deterministic execution and CI evaluation
NL2SQL_LLM_PROVIDER=mock

# Default Model Selection
# For Anthropic: "claude-3-5-sonnet-20241022", "claude-3-opus-20240229", etc.
# For OpenAI: "gpt-4o", "gpt-4-turbo", "gpt-3.5-turbo"
# NL2SQL_LLM_MODEL=claude-3-5-sonnet-20241022

# API Credentials (leave blank if running with provider=mock)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Pipeline Defaults
NL2SQL_DEFAULT_DB_PATH=store.db
NL2SQL_MAX_CORRECTION_RETRIES=2
NL2SQL_QUERY_TIMEOUT_SECONDS=5.0
NL2SQL_APPROACH=whole_schema
